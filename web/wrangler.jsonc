// Cloudflare Workers static assets: the built web app (pnpm build:site),
// with every unknown path served index.html so the router handles
// /settings, /invite/<code> and the rest on a reload.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitchord",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./app/dist",
    "not_found_handling": "single-page-application"
  }
}
